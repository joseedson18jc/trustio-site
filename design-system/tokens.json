    "surface-blue-rgb": {
      "$value": "11, 23, 48",
      "$type": "string",
      "$description": "Canal RGB para rgba(var(--x), alpha)"
    }
  },
  "gradient": {
    "cta-gradient": {
      "$value": "linear-gradient(135deg, #2f6df0, #2563eb 55%, #1a49b8)",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
    },
    "card-gradient": {
      "$value": "linear-gradient(145deg, rgba(18, 24, 35, 0.74), rgba(7, 9, 14, 0.52))",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
    },
    "card-gradient-strong": {
      "$value": "linear-gradient(145deg, rgba(17, 22, 31, 0.8), rgba(8, 10, 15, 0.7))",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
    },
    "card-gradient-hover": {
      "$value": "linear-gradient(145deg, rgba(20, 29, 45, 0.9), rgba(8, 10, 15, 0.78))",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
