      "$extensions": {
        "composite": true
      }
    },
    "card-gradient-deep": {
      "$value": "linear-gradient(145deg, rgba(15, 27, 49, 0.84), rgba(7, 10, 16, 0.9))",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
    },
    "panel-gradient": {
      "$value": "linear-gradient(155deg, rgba(20, 27, 40, 0.86), rgba(7, 9, 14, 0.9))",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
    },
    "panel-gradient-deep": {
      "$value": "linear-gradient(150deg, rgba(14, 23, 39, 0.92), rgba(6, 9, 15, 0.96))",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
    },
    "section-wash": {
      "$value": "linear-gradient(150deg, rgba(10, 29, 61, 0.17), rgba(5, 7, 11, 0.2) 50%)",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
    },
    "declaration-gradient": {
      "$value": "linear-gradient(135deg, #08142b, #05070b 60%)",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
    },
    "layer-gradient": {
      "$value": "linear-gradient(135deg, rgba(19, 26, 38, 0.95), rgba(8, 10, 15, 0.95))",
      "$type": "gradient",
      "$extensions": {
        "composite": true
      }
    }
  },
  "layout": {
    "container": {
      "$value": "min(1180px, calc(100vw - 48px))",
      "$type": "dimension",
      "$extensions": {
        "composite": true,
        "note": "min(1180px, calc(100vw - 48px)) — largura fluida com sarjeta de 24px por lado"
      }
    }
  },
  "font": {
    "display": {
      "$value": "\"Geist\", \"Inter\", \"Segoe UI\", system-ui, sans-serif",
      "$type": "fontFamily"
    },
